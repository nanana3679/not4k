.omc/
.claude/
.worktrees/

.env*

node_modules/
dist/
dist-lab/
# 빌드된 스킨 PNG는 산출물이라 기본 무시.
# crystal·classic과 Lab 비교용 simple은 에셋 빌드 미실행 환경에서도 사용할 수 있게 보관한다.
# prism은 아직 failed 에셋이 불완전하다. Classic SVG 시연 자료는 public/lab/note-assets/classic에 둔다.
public/skins/*
!public/skins/crystal/
!public/skins/classic/
!public/skins/simple/
__pycache__/
*.pyc

# AI-generated image experiments are large and reproducible.
# Generated images, prompts, and per-run metadata stay local.
# Keep only the storage convention doc in Git.
public/lab/gear-samples/**
!public/lab/gear-samples/
!public/lab/gear-samples/README.md

# Example generated pair names covered by the directory-wide ignore above.
public/lab/gear-samples/**/gear-source.png
public/lab/gear-samples/**/gear-source.md
public/lab/gear-samples/**/metadata.json

# Adopted lab demo fixture for the runtime gauge layer preview.
!public/lab/gear-samples/compact-set-03/
!public/lab/gear-samples/compact-set-03/gear-source.png
!public/lab/gear-samples/compact-set-03/gear-back.png
!public/lab/gear-samples/compact-set-03/gear-front.png
!public/lab/gear-samples/compact-set-03/skin-runtime-config.json

# Curated lab fixtures referenced by src/lab/gearLightAssets.ts.
!public/lab/gear-samples/option-2[1-4]/
!public/lab/gear-samples/option-2[1-4]/gear-source.png
!public/lab/gear-samples/option-2[1-4]/gear-base.png
!public/lab/gear-samples/option-2[1-4]/gear-glow.png
!public/lab/gear-samples/option-2[1-4]/gear-gauge.png
!public/lab/gear-samples/option-2[1-4]/gear-metadata.json
!public/lab/gear-samples/ai-option-0[1-3]/
!public/lab/gear-samples/ai-option-0[1-3]/gear-source.png
!public/lab/gear-samples/ai-option-0[1-3]/gear-base.png
!public/lab/gear-samples/ai-option-0[1-3]/gear-glow.png
!public/lab/gear-samples/ai-option-0[1-3]/gear-gauge.png
!public/lab/gear-samples/ai-option-0[1-3]/gear-metadata.json

